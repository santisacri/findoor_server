// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OperationType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
}

enum Currency {
  ARS
  USD
}

model User {
  id                    String         @id @default(uuid(7))
  name                  String
  email                 String         @unique()
  password              String
  phone                 Int?
  isVerified            Boolean        @default(false) @map("is_verified")
  createdAt             DateTime       @default(now()) @map("created_at")
  verificationToken     String?        @map("verification_token")
  verificationExpiresAt DateTime?      @map("verification_expires_at")
  resetToken            String?        @map("reset_token")
  resetTokenExpiresAt   DateTime?      @map("reset_token_expires_at")
  properties            Property[]
  favorites             Favorite[]
  contactLeads          ContactLead[]
  refreshTokens         RefreshToken[]

  @@map("users")
}

model Property {
  id            String        @id @default(uuid(7))
  ownerId       String        @map("owner_id")
  operationType OperationType @map("operation_type")
  propertyType  PropertyType  @map("property_type")
  title         String
  description   String
  price         Int
  currency      Currency      @default(USD)
  totalAreaM2   Int           @map("total_area_m2")
  coveredAreaM2 Int?          @map("covered_area_m2")
  bedrooms      Int
  bathrooms     Int
  parkingSpots  Int           @map("parking_spots")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address       Address?
  favorites     Favorite[]
  contactLeads  ContactLead[]
  photos        Photo[]

  @@map("properties")
}

model Address {
  id           String   @id @default(uuid(7))
  propertyId   String   @unique @map("property_id")
  province     String
  city         String
  neighborhood String?
  street       String?
  streetNumber String?  @map("street_number")
  lat          Float?
  lon          Float?
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Favorite {
  id         String   @id @default(uuid(7))
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favorites")
}

model ContactLead {
  id         String   @id @default(uuid(7))
  propertyId String   @map("property_id")
  senderId   String   @map("sender_id")
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("contact_leads")
}

model Photo {
  id         String @id @default(uuid(7))
  propertyId String @map("property_id")
  url        String
  publicId   String @map("public_id")
  order      Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  token     String    @unique @default(uuid(7))
  userId    String
  family    String    @default(uuid(7))
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
